+void setPadInput(int pad, int button, int value)
+{
+	if(!g_inputProvider || (pad < 0) || (pad >= static_cast<int>(MAX_JS_PADS))) return;
+	g_inputProvider->SetVirtualInput(pad, button, value);
+}
+
+//Pause/resume never block the browser's main thread: the emulator thread may
+//need the main thread (WebGL, audio and disc reads are proxied to it).
+void pauseVm()
+{
+	g_virtualMachine->PauseAsync();
+}
+
+void resumeVm()
+{
+	g_virtualMachine->ResumeAsync();
+}
+
+bool isVmRunning()
+{
+	return g_virtualMachine->GetStatus() == CVirtualMachine::RUNNING;
+}
+
+bool saveState(std::string path)
+{
+	if(g_stateFuture.valid()) return false;
+	g_stateFuture = g_virtualMachine->SaveState(path);
+	return true;
+}
+
+bool loadState(std::string path)
+{
+	if(g_stateFuture.valid()) return false;
+	g_stateFuture = g_virtualMachine->LoadState(path);
+	return true;
+}
+
+//0: in progress, 1: succeeded, -1: failed, 2: no operation pending
+int getStateResult()
+{
+	if(!g_stateFuture.valid()) return 2;
+	if(g_stateFuture.wait_for(std::chrono::seconds(0)) != std::future_status::ready) return 0;
+	return g_stateFuture.get() ? 1 : -1;
+}
+
+static void updatePresentation()
+{
+	CGSHandler::PRESENTATION_PARAMS presentationParams;
+	presentationParams.mode = g_presentationMode;
+	presentationParams.windowWidth = g_outputWidth;
+	presentationParams.windowHeight = g_outputHeight;
+	g_virtualMachine->m_ee->m_gs->SetPresentationParams(presentationParams);
+}
+
+void setOutputSize(int width, int height)
+{
+	if((width <= 0) || (height <= 0)) return;
+	g_outputWidth = width;
+	g_outputHeight = height;
+	emscripten_set_canvas_element_size("#outputCanvas", width, height);
+	updatePresentation();
+}
+
+void setPresentationMode(int mode)
+{
+	if((mode < CGSHandler::PRESENTATION_MODE_FILL) || (mode > CGSHandler::PRESENTATION_MODE_ORIGINAL)) return;
+	g_presentationMode = static_cast<CGSHandler::PRESENTATION_MODE>(mode);
+	updatePresentation();
+}
+
+void setResolutionFactor(int factor)
+{
+	if((factor < 1) || (factor > 8)) return;
+	CAppConfig::GetInstance().SetPreferenceInteger(PREF_CGSH_OPENGL_RESOLUTION_FACTOR, factor);
+	g_virtualMachine->m_ee->m_gs->NotifyPreferencesChanged();
+}
+
+void setFrameLimit(bool enabled)
+{
+	CAppConfig::GetInstance().SetPreferenceBoolean(PREF_PS2_LIMIT_FRAMERATE, enabled);
+	g_virtualMachine->ReloadFrameRateLimit();
+}
+
+void setVolume(float volume)
+{
+	alListenerf(AL_GAIN, std::max(0.0f, std::min(volume, 1.0f)));
+}
+
+std::string getVersion()
+{
+	return PLAY_VERSION;
+}
