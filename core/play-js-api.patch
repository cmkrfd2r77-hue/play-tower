 {
 	OnInput(MakeBindingTarget(code), 0);
 }
+
+BINDINGTARGET CInputProviderEmscripten::MakeVirtualBindingTarget(uint32 pad, PS2::CControllerInfo::BUTTON button)
+{
+	auto keyType = PS2::CControllerInfo::IsAxis(button) ? BINDINGTARGET::KEYTYPE::AXIS : BINDINGTARGET::KEYTYPE::BUTTON;
+	return BINDINGTARGET(PROVIDER_ID, DeviceIdType{{pad + 1}}, button, keyType);
+}
+
+void CInputProviderEmscripten::SetVirtualInput(uint32 pad, uint32 button, uint32 value)
+{
+	if(button >= PS2::CControllerInfo::MAX_BUTTONS) return;
+	OnInput(MakeVirtualBindingTarget(pad, static_cast<PS2::CControllerInfo::BUTTON>(button)), value);
+}
